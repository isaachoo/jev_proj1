# Copy to .env.local and fill in.
OPENROUTER_API_KEY=sk-or-...

# Jev decision model (Decisions API).
JEV_MODEL=typesafe/jev-1.13

# Chat model used to draft options, run web search, and explain the decision.
CHAT_MODEL=typesafe/jev-router

# Set to 1 to run without any network calls (fake data + fake decisions).
MOCK=0
